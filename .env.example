# Copy to `.env.local` and fill in. `.env.local` is gitignored; THIS file is committed,
# so every value below is a placeholder and never a real credential.
# Schema + validation: src/lib/env.ts. Parity pin: src/lib/env-example-parity.test.ts
# (every key env.ts reads appears here, with a one-line comment above it).
# A new var goes in three places: .env.local, the Vercel project env, and env.ts.
# Supabase project for this app: partyreel (ref ddafaemglzmuekbtjwzn).

# --- Supabase (the public pair is browser-safe; RLS still applies) ---
# Project API URL (dashboard -> Project Settings -> Data API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (the old "anon" key): browser-safe, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (the old "service_role" key): server-only, BYPASSES RLS. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Site + surfaces ---
# Canonical origin for absolute QR/share links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# qr_token of the curated demo event; blank hides every demo surface.
NEXT_PUBLIC_DEMO_QR_TOKEN=
# Host serving the internal portal (prod: admin.partyreel.com); blank = /admin is direct.
NEXT_PUBLIC_ADMIN_HOST=
# Which surface this build serves: "admin" (the partyreel-admin project) or "app"; blank = both.
NEXT_PUBLIC_SURFACE=
# Gate key for the /design playground; blank = the playground 404s everywhere.
DESIGN_PREVIEW_KEY=

# --- Cloudflare R2 (media storage; server-only) ---
# Cloudflare account id that owns the bucket.
R2_ACCOUNT_ID=
# S3 API access key id (Cloudflare -> R2 -> API tokens).
R2_ACCESS_KEY_ID=
# S3 API secret access key; Cloudflare shows it once, at token creation.
R2_SECRET_ACCESS_KEY=
# Bucket name (partyreel).
R2_BUCKET=

# --- Stripe (TEST mode today; the live cutover is docs/PRICING.md "Test to live") ---
# Secret API key: sk_test_ in test mode, sk_live_ once the account is live.
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint (whsec_), per mode.
STRIPE_WEBHOOK_SECRET=
# Pro 100 GB, monthly ($9).
STRIPE_PRICE_PRO_100=price_xxx
# Pro 500 GB, monthly ($19).
STRIPE_PRICE_PRO_500=price_xxx
# Pro 2 TB, monthly ($39).
STRIPE_PRICE_PRO_2TB=price_xxx
# Pro 100 GB, annual ($90), on the SAME product as the monthly price.
STRIPE_PRICE_PRO_100_YR=price_xxx
# Pro 500 GB, annual ($190), same product as _PRO_500.
STRIPE_PRICE_PRO_500_YR=price_xxx
# Pro 2 TB, annual ($390), same product as _PRO_2TB.
STRIPE_PRICE_PRO_2TB_YR=price_xxx
# Event Pass, one-time ($24).
STRIPE_PRICE_EVENT_PASS=price_xxx
# Event Pass renewal, one-time ($15), on the Event Pass product.
STRIPE_PRICE_EVENT_PASS_RENEWAL=price_xxx

# --- Email (Resend) ---
# Resend API key (re_); it is also the SMTP password for Supabase Auth mail.
RESEND_API_KEY=
# Verified sender for transactional mail, e.g. Partyreel <noreply@partyreel.com>.
EMAIL_FROM=
# Inbox that receives contact + careers notifications; blank falls back to SUPPORT_EMAIL.
CONTACT_NOTIFY_EMAIL=

# --- Job + route secrets (server-only; each route fails closed when its var is unset) ---
# Vercel sends this as `Authorization: Bearer` to the purge cron, which verifies it.
CRON_SECRET=
# HMAC secret signing the password-protected-album unlock cookie.
UNLOCK_COOKIE_SECRET=
# Shared bearer between the backup Worker's prune pass and /api/internal/backup-prune.
# Same value here and in the Worker (`wrangler secret put PRUNE_API_SECRET`).
PRUNE_API_SECRET=
# HMAC secret the export mint routes sign the manifest token with.
# Same value here and in the Worker (`wrangler secret put EXPORT_SIGNING_SECRET`).
EXPORT_SIGNING_SECRET=
# Deployed export Worker origin the browser form-POSTs the token to.
EXPORT_WORKER_URL=

# --- Sentry (error tracking) ---
# DSN is public/browser-safe; blank makes Sentry a no-op everywhere.
NEXT_PUBLIC_SENTRY_DSN=
# BUILD-TIME ONLY (read by next.config.ts, never by env.ts): source-map upload token.
SENTRY_AUTH_TOKEN=
# BUILD-TIME ONLY: Sentry org slug.
SENTRY_ORG=
# BUILD-TIME ONLY: Sentry project slug.
SENTRY_PROJECT=
