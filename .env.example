# Copy to `.env.local` and fill in. `.env.local` is gitignored; this template is
# committed (no real secrets here). Schema + validation: src/lib/env.ts.
# Supabase project for this app: partyreel (ref ddafaemglzmuekbtjwzn).

# --- Supabase (public; browser-safe — RLS still applies) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Canonical site origin for absolute QR/share links + OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interactive demo: the qr_token of a curated demo event. When set, marketing shows a
# real scannable demo QR + a "Try the live demo" CTA, and that event's guest page
# simulates uploads (nothing is saved). Optional; leave blank to disable the demo.
NEXT_PUBLIC_DEMO_QR_TOKEN=

# --- Server-only secrets (NEVER prefix NEXT_PUBLIC_; never commit real values) ---
# Service-role key — bypasses RLS. Needed by the Stripe webhook (Phase 4) and the
# purge cron (Phase 3). Supabase dashboard → Project Settings → API keys → secret.
SUPABASE_SECRET_KEY=

# Cloudflare R2 (Phase 2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Stripe (Phase 4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin / operations portal ---
# Host that serves the internal portal. Set in prod (e.g. admin.partyreel.com) so the
# portal is gated to the subdomain; leave blank in dev (then /admin is reachable directly).
NEXT_PUBLIC_ADMIN_HOST=

# --- Sentry (error tracking — free Developer tier) ---
# DSN is public/browser-safe; unset = Sentry is a no-op. The auth token + org/project are
# build-time only (source-map upload): Sentry → Settings → Auth Tokens (Organization Auth Token).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Media backup prune (ADR-0013, Pillar B) ---
# Shared bearer secret between this app and the media-backup Worker (workers/backup). The Worker's
# weekly `prune` branch POSTs candidate mediaIds to /api/internal/backup-prune with this as a bearer
# token; the route verifies it before confirming any backup deletions. Set the SAME random value here
# (Vercel + .env.local) and in the Worker (`wrangler secret put PRUNE_API_SECRET`). Optional to build.
PRUNE_API_SECRET=

# --- Download all / zip export (the streaming export Worker, workers/export) ---
# EXPORT_SIGNING_SECRET: HMAC secret the mint routes sign the manifest token with and the Worker
# verifies. Set the SAME random value here (Vercel + .env.local) and in the Worker
# (`wrangler secret put EXPORT_SIGNING_SECRET`). EXPORT_WORKER_URL: the deployed Worker origin the
# browser form-POSTs the token to (the *.workers.dev URL for v1). Both optional to build.
EXPORT_SIGNING_SECRET=
EXPORT_WORKER_URL=
