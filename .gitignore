# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but DO commit the template (no secrets in it).
!.env.example

# wrangler local dev secrets (Cloudflare Workers) — never commit
.dev.vars
.dev.vars.*

# vercel
.vercel

# Test-media fixtures live NEXT TO the repo at /Users/gibby/local/ai/partyreel-test-media/ (real
# images/videos for live upload testing) — a normal folder the user can connect to the upload
# sandbox + the native picker can navigate to (it hides dotfolders).
# This stale in-repo path stays ignored in case fixtures are ever staged here by mistake.
.test-media/

# typescript
*.tsbuildinfo
next-env.d.ts
