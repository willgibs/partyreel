    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "shadcn": "^4.8.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
